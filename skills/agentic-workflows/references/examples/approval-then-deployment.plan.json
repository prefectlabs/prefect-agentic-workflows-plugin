{
  "kind": "ExecutionPlan",
  "schema_version": "0.2",
  "inputs": {
    "request": {
      "schema": {
        "type": "string",
        "description": "A backfill request in plain words, for example 'reload orders from March 1 to March 7'."
      },
      "required": true
    }
  },
  "nodes": {
    "plan_backfill": {
      "kind": "AgentNode",
      "label": "Plan the backfill",
      "objective": "Read the backfill request in the `request` input. When it names a clear date range, select the `ready` output with `start_date` and `end_date` as ISO dates (YYYY-MM-DD). When the range is missing or unclear, select the `needs_detail` output with `question`, one sentence that asks the requester for what is missing.",
      "inputs": {
        "request": {
          "schema": {"type": "string"},
          "expects": {"cardinality": "exactly_one", "shape": "value"}
        }
      },
      "outputs": {
        "ready": {
          "schema": {
            "type": "object",
            "properties": {
              "start_date": {"type": "string", "format": "date"},
              "end_date": {"type": "string", "format": "date"}
            },
            "required": ["start_date", "end_date"],
            "additionalProperties": false
          }
        },
        "needs_detail": {
          "schema": {
            "type": "object",
            "properties": {"question": {"type": "string"}},
            "required": ["question"]
          }
        }
      },
      "orchestration": {
        "output_selection": "exactly_one",
        "evaluate_when": "all_required_inputs_produced"
      }
    },
    "approve_backfill": {
      "kind": "HumanInputNode",
      "label": "Approve the backfill",
      "human_input": {
        "form_schema": {
          "type": "object",
          "title": "Run this backfill?",
          "properties": {
            "decision": {
              "type": "string",
              "enum": ["approved", "rejected"],
              "title": "Decision"
            },
            "notes": {"type": "string", "title": "Notes"}
          },
          "required": ["decision"]
        },
        "deadline": {
          "after": "P3D",
          "on_expiry": {
            "output": "expired",
            "value": {"reason": "Nobody answered within 3 days."}
          }
        }
      },
      "inputs": {
        "request": {
          "schema": {
            "type": "object",
            "properties": {
              "start_date": {"type": "string", "format": "date"},
              "end_date": {"type": "string", "format": "date"}
            },
            "required": ["start_date", "end_date"]
          },
          "expects": {"cardinality": "exactly_one", "shape": "value"}
        }
      },
      "outputs": {
        "approved": {
          "schema": {
            "type": "object",
            "properties": {
              "decision": {"type": "string"},
              "notes": {"type": "string"}
            },
            "required": ["decision"]
          }
        },
        "rejected": {
          "schema": {
            "type": "object",
            "properties": {
              "decision": {"type": "string"},
              "notes": {"type": "string"}
            },
            "required": ["decision"]
          }
        },
        "expired": {
          "schema": {
            "type": "object",
            "properties": {"reason": {"type": "string"}},
            "required": ["reason"]
          }
        }
      },
      "orchestration": {
        "output_selection": "exactly_one",
        "evaluate_when": "all_required_inputs_produced"
      }
    },
    "run_backfill": {
      "kind": "DeploymentNode",
      "label": "Run the backfill deployment",
      "deployment": {"id": "00000000-0000-0000-0000-000000000000"},
      "wait": {"for": "child_flow_run", "until": "terminal"},
      "inputs": {
        "parameters": {
          "schema": {
            "type": "object",
            "properties": {
              "start_date": {"type": "string", "format": "date"},
              "end_date": {"type": "string", "format": "date"}
            },
            "required": ["start_date", "end_date"]
          },
          "expects": {"cardinality": "exactly_one", "shape": "value"}
        },
        "approval": {
          "schema": {"type": "object"},
          "expects": {"cardinality": "exactly_one", "shape": "value"}
        }
      },
      "outputs": {
        "completed": {
          "schema": {
            "type": "object",
            "properties": {
              "child_flow_run_id": {"type": "string"},
              "state": {"type": "string"}
            },
            "required": ["child_flow_run_id", "state"]
          }
        },
        "failed": {
          "schema": {
            "type": "object",
            "properties": {
              "child_flow_run_id": {"type": "string"},
              "state": {"type": "string"}
            },
            "required": ["child_flow_run_id", "state"]
          }
        }
      },
      "orchestration": {
        "output_selection": "exactly_one",
        "evaluate_when": "all_required_inputs_produced"
      }
    }
  },
  "edges": [
    {
      "id": "request-to-plan_backfill",
      "from": {"type": "plan_input", "input": "request"},
      "to": {"node": "plan_backfill", "input": "request"}
    },
    {
      "id": "ready-to-approve_backfill",
      "from": {"type": "node_output", "node": "plan_backfill", "output": "ready"},
      "to": {"node": "approve_backfill", "input": "request"}
    },
    {
      "id": "ready-to-run_backfill",
      "from": {"type": "node_output", "node": "plan_backfill", "output": "ready"},
      "to": {"node": "run_backfill", "input": "parameters"}
    },
    {
      "id": "approved-to-run_backfill",
      "from": {"type": "node_output", "node": "approve_backfill", "output": "approved"},
      "to": {"node": "run_backfill", "input": "approval"}
    }
  ],
  "outputs": {
    "result": {
      "fields": {
        "backfill_run": {
          "schema": {
            "type": "object",
            "properties": {
              "child_flow_run_id": {"type": "string"},
              "state": {"type": "string"}
            },
            "required": ["child_flow_run_id", "state"]
          },
          "source": {
            "type": "one_of",
            "one_of": [
              {"type": "node_output", "node": "run_backfill", "output": "completed"},
              {"type": "node_output", "node": "run_backfill", "output": "failed"}
            ]
          }
        },
        "question": {
          "schema": {
            "type": "object",
            "properties": {"question": {"type": "string"}},
            "required": ["question"]
          },
          "source": {
            "type": "node_output",
            "node": "plan_backfill",
            "output": "needs_detail"
          }
        }
      }
    }
  }
}

{
  "kind": "ExecutionPlan",
  "schema_version": "0.4",
  "inputs": {
    "tickets": {
      "schema": {
        "type": "array",
        "title": "Support tickets",
        "description": "The tickets to sort, at most 100, each with its ticket ID and the customer's text.",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "text": {"type": "string", "minLength": 1}
          },
          "required": ["id", "text"]
        }
      },
      "required": true
    }
  },
  "nodes": {
    "triage_ticket": {
      "kind": "AgentNode",
      "label": "Sort one ticket",
      "objective": "Read the support ticket in the `ticket` input. Sort it into one category: `question` when the customer asks how to do something, `bug` when something doesn't work as expected, or `feature_request` when the customer asks for something new. Select the `triaged` output with `category` and `summary`, one sentence under 30 words that says what the customer needs. When the ticket text is empty, unreadable, or not a support request, select the `blocked` output instead, with `reason` and `summary` set to one sentence that says why you couldn't sort it.",
      "model": {"connection_id": "00000000-0000-0000-0000-000000000000", "id": "claude-opus-5-5"},
      "inputs": {
        "ticket": {
          "schema": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "text": {"type": "string"}
            },
            "required": ["id", "text"]
          }
        }
      },
      "outputs": {
        "triaged": {
          "schema": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "enum": ["question", "bug", "feature_request"]
              },
              "summary": {"type": "string"}
            },
            "required": ["category", "summary"],
            "additionalProperties": false
          }
        },
        "blocked": {
          "schema": {
            "type": "object",
            "properties": {
              "reason": {"type": "string"},
              "summary": {"type": "string"}
            },
            "required": ["reason", "summary"],
            "additionalProperties": false
          }
        }
      },
      "orchestration": {
        "output_selection": "exactly_one",
        "evaluate_when": "all_required_inputs_produced",
        "map": {"input": "ticket", "key": "$.id", "concurrency": 5}
      }
    },
    "write_report": {
      "kind": "AgentNode",
      "label": "Write the triage report",
      "objective": "The `triaged` input maps each ticket ID to the ticket's category and summary. The `blocked` input, when present, maps each ticket ID that couldn't be sorted to the reason. Write and run a short script that counts the tickets in each category and the blocked tickets, and use its counts. Then write a report in Markdown under 300 words: one line with the counts, then one section for each category that lists each ticket ID with its summary, then the blocked ticket IDs with their reasons. Select the `report_ready` output with `report` and `summary`, one sentence with the counts. When the `triaged` input is empty or unreadable, select the `blocked` output with `reason` and `summary` set to one sentence that says why.",
      "model": {"connection_id": "00000000-0000-0000-0000-000000000000", "id": "claude-opus-5-5"},
      "inputs": {
        "triaged": {
          "schema": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "category": {"type": "string"},
                "summary": {"type": "string"}
              },
              "required": ["category", "summary"]
            }
          },
          "expects": {"cardinality": "exactly_one", "shape": "value"}
        },
        "blocked": {
          "schema": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "reason": {"type": "string"},
                "summary": {"type": "string"}
              },
              "required": ["reason", "summary"]
            }
          },
          "expects": {"cardinality": "zero_or_one", "shape": "value"}
        }
      },
      "outputs": {
        "report_ready": {
          "schema": {
            "type": "object",
            "properties": {
              "report": {"type": "string"},
              "summary": {"type": "string"}
            },
            "required": ["report", "summary"],
            "additionalProperties": false
          }
        },
        "blocked": {
          "schema": {
            "type": "object",
            "properties": {
              "reason": {"type": "string"},
              "summary": {"type": "string"}
            },
            "required": ["reason", "summary"],
            "additionalProperties": false
          }
        }
      },
      "orchestration": {
        "output_selection": "exactly_one",
        "evaluate_when": "all_reachable_terminal"
      }
    }
  },
  "edges": [
    {
      "id": "tickets_to_triage_ticket",
      "from": {"type": "plan_input", "input": "tickets"},
      "to": {"node": "triage_ticket", "input": "ticket"}
    },
    {
      "id": "triaged_to_write_report",
      "from": {"type": "node_output", "node": "triage_ticket", "output": "triaged"},
      "to": {"node": "write_report", "input": "triaged"}
    },
    {
      "id": "blocked_to_write_report",
      "from": {"type": "node_output", "node": "triage_ticket", "output": "blocked"},
      "to": {"node": "write_report", "input": "blocked"}
    }
  ],
  "outputs": {
    "triage": {
      "fields": {
        "tickets": {
          "schema": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "category": {"type": "string"},
                "summary": {"type": "string"}
              },
              "required": ["category", "summary"]
            }
          },
          "source": {"type": "node_output", "node": "triage_ticket", "output": "triaged"}
        }
      },
      "required": ["tickets"]
    },
    "report": {
      "fields": {
        "report": {
          "schema": {
            "type": "object",
            "properties": {
              "report": {"type": "string"},
              "summary": {"type": "string"}
            },
            "required": ["report", "summary"]
          },
          "source": {"type": "node_output", "node": "write_report", "output": "report_ready"}
        }
      },
      "required": ["report"]
    }
  }
}

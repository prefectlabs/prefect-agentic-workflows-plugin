  "additionalProperties": false,
  "description": "Top-level authored execution plan document for schema version 0.1.\n\nThe document declares its version and kind, named plan inputs, named nodes,\nedges between value sources and node inputs, and optional orchestration\nsettings for the graph.",
  "properties": {
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "ExecutionPlan",
      "title": "Kind",
      "type": "string"
    },
    "inputs": {
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_.-]*$": {
          "$ref": "#/$defs/PlanInput"
        }
      },
      "title": "Inputs",
      "type": "object"
    },
    "nodes": {
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_.-]*$": {
          "discriminator": {
            "mapping": {
              "AgentNode": "#/$defs/AgentNode",
              "DeploymentNode": "#/$defs/DeploymentNode",
              "HumanInputNode": "#/$defs/HumanInputNode",
              "TimerNode": "#/$defs/TimerNode"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AgentNode"
            },
            {
              "$ref": "#/$defs/HumanInputNode"
            },
            {
              "$ref": "#/$defs/TimerNode"
            },
            {
              "$ref": "#/$defs/DeploymentNode"
            }
          ]
        }
      },
      "title": "Nodes",
      "type": "object"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "title": "Edges",
      "type": "array"
    },
    "orchestration": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanOrchestration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "kind",
    "nodes",
    "edges"
  ],
  "title": "ExecutionPlan",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",

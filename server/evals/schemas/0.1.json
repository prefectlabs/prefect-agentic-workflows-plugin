{
  "$defs": {
    "AgentNode": {
      "additionalProperties": false,
      "description": "A node that describes agent work over an objective and optional MCP tools.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "inputs": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_.-]*$": {
              "$ref": "#/$defs/InputPort"
            }
          },
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_.-]*$": {
              "$ref": "#/$defs/OutputPort"
            }
          },
          "title": "Outputs",
          "type": "object"
        },
        "orchestration": {
          "$ref": "#/$defs/NodeOrchestration"
        },
        "kind": {
          "const": "AgentNode",
          "title": "Kind",
          "type": "string"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "orchestration",
        "kind",
        "objective"
      ],
      "title": "AgentNode",
      "type": "object"
    },
    "DeploymentNode": {
      "additionalProperties": false,
      "description": "A node that describes running a Prefect deployment and waiting for completion.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "inputs": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_.-]*$": {
              "$ref": "#/$defs/InputPort"
            }
          },
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_.-]*$": {
              "$ref": "#/$defs/OutputPort"
            }
          },
          "title": "Outputs",
          "type": "object"
        },
        "orchestration": {
          "$ref": "#/$defs/NodeOrchestration"
        },
        "kind": {
          "const": "DeploymentNode",
          "title": "Kind",
          "type": "string"
        },
        "deployment": {
          "$ref": "#/$defs/DeploymentReference"
        },
        "wait": {
          "$ref": "#/$defs/DeploymentWait"
        }
      },
      "required": [
        "orchestration",
        "kind",
        "deployment",
        "wait"
      ],
      "title": "DeploymentNode",
      "type": "object"
    },
    "DeploymentReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "DeploymentReference",
      "type": "object"
    },
    "DeploymentWait": {
      "additionalProperties": false,
      "properties": {
        "for": {
          "const": "child_flow_run",
          "title": "For",
          "type": "string"
        },
        "until": {
          "const": "terminal",
          "title": "Until",
          "type": "string"
        }
      },
      "required": [
        "for",
        "until"
      ],
      "title": "DeploymentWait",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "description": "A directed value connection from a plan input or node output to a node input.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "from": {
          "discriminator": {
            "mapping": {
              "node_output": "#/$defs/NodeOutputRef",
              "plan_input": "#/$defs/PlanInputRef"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PlanInputRef"
            },
            {
              "$ref": "#/$defs/NodeOutputRef"
            }
          ],
          "title": "From"
        },
        "to": {
          "$ref": "#/$defs/NodeInputRef"
        }
      },
      "required": [
        "id",
        "from",
        "to"
      ],
      "title": "Edge",
      "type": "object"
    },
    "HumanInputDeadline": {
      "additionalProperties": false,
      "description": "An optional HumanInput deadline with an optional handled expiry.",
      "properties": {
        "after": {
          "minLength": 1,
          "title": "After",
          "type": "string"
        },
        "on_expiry": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumanInputExpiry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "after"
      ],
      "title": "HumanInputDeadline",
      "type": "object"
    },
    "HumanInputExpiry": {
      "additionalProperties": false,
      "description": "The handled expiry for a HumanInput deadline.\n\nBinds one declared expiry-only output to the literal JSON value it\nreceives when the deadline passes before a human response.",
      "properties": {
        "output": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
          "title": "Output",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "output",
        "value"
      ],
      "title": "HumanInputExpiry",
      "type": "object"
    },
    "HumanInputNode": {
      "additionalProperties": false,
      "description": "A node that describes a pause for structured human-provided input.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "inputs": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_.-]*$": {
              "$ref": "#/$defs/InputPort"
            }
          },
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_.-]*$": {
              "$ref": "#/$defs/OutputPort"
            }
          },
          "title": "Outputs",
          "type": "object"
        },
        "orchestration": {
          "$ref": "#/$defs/NodeOrchestration"
        },
        "kind": {
          "const": "HumanInputNode",
          "title": "Kind",
          "type": "string"
        },
        "human_input": {
          "$ref": "#/$defs/HumanInputSettings"
        }
      },
      "required": [
        "orchestration",
        "kind",
        "human_input"
      ],
      "title": "HumanInputNode",
      "type": "object"
    },
    "HumanInputSettings": {
      "additionalProperties": false,
      "properties": {
        "deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumanInputDeadline"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "form_schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Form Schema"
        }
      },
      "title": "HumanInputSettings",
      "type": "object"
    },
    "InputExpectation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "shape": {
                "const": "value"
              }
            },
            "required": [
              "shape"
            ]
          },
          "then": {
            "not": {
              "required": [
                "key_by"
              ]
            },
            "properties": {
              "cardinality": {
                "enum": [
                  "exactly_one",
                  "zero_or_one"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "list"
              }
            },
            "required": [
              "shape"
            ]
          },
          "then": {
            "not": {
              "required": [
                "key_by"
              ]
            },
            "properties": {
              "cardinality": {
                "enum": [
                  "one_or_more",
                  "zero_or_more"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "source_map"
              }
            },
            "required": [
              "shape"
            ]
          },
          "then": {
            "properties": {
              "cardinality": {
                "enum": [
                  "one_or_more",
                  "zero_or_more"
                ]
              },
              "key_by": {
                "const": "edge"
              }
            },
            "required": [
              "key_by"
            ]
          }
        }
      ],
      "description": "Rules for how a node input accepts values from upstream edges.",
      "properties": {
        "cardinality": {
          "enum": [
            "exactly_one",
            "zero_or_one",
            "one_or_more",
            "zero_or_more"
          ],
          "title": "Cardinality",
          "type": "string"
        },
        "shape": {
          "enum": [
            "value",
            "list",
            "source_map"
          ],
          "title": "Shape",
          "type": "string"
        },
        "key_by": {
          "anyOf": [
            {
              "const": "edge",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key By"
        }
      },
      "required": [
        "cardinality",
        "shape"
      ],
      "title": "InputExpectation",
      "type": "object"
    },
    "InputPort": {
      "additionalProperties": false,
      "description": "A node input port whose JSON Schema describes accepted inbound values.",
      "properties": {
        "schema": {
          "$ref": "#/$defs/JsonSchema"
        },
        "expects": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputExpectation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schema"
      ],
      "title": "InputPort",
      "type": "object"
    },
    "McpBlockDocumentReference": {
      "additionalProperties": false,
      "description": "A workspace block document reference used for MCP credential values.",
      "properties": {
        "block_document_id": {
          "format": "uuid",
          "title": "Block Document Id",
          "type": "string"
        }
      },
      "required": [
        "block_document_id"
      ],
      "title": "McpBlockDocumentReference",
      "type": "object"
    },
    "McpConfig": {
      "additionalProperties": false,
      "properties": {
        "mcpServers": {
          "additionalProperties": false,
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_.-]*$": {
              "$ref": "#/$defs/McpHttpServer"
            }
          },
          "title": "Mcpservers",
          "type": "object"
        }
      },
      "required": [
        "mcpServers"
      ],
      "title": "McpConfig",
      "type": "object",
      "examples": [
        {
          "mcpServers": {
            "remote_tools": {
              "type": "http",
              "url": "https://mcp.example.com/tools",
              "headers": {
                "Accept": "application/json",
                "Authorization": {
                  "$ref": {
                    "block_document_id": "11111111-1111-4111-8111-111111111111"
                  }
                }
              },
              "query": {
                "transport": "sse",
                "api_key": {
                  "$ref": {
                    "block_document_id": "22222222-2222-4222-8222-222222222222"
                  }
                }
              },
              "timeout": 30
            }
          }
        }
      ]
    },
    "McpHttpServer": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "http",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "not": {
            "pattern": "/sse(/|$)"
          },
          "pattern": "^https?://[^/?#@;]+(/[^;?#]*)?$",
          "title": "Url",
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/McpSecretReference"
              },
              {
                "not": {
                  "pattern": "\\{\\{\\s*prefect\\.blocks\\.[^}]+\\}\\}"
                },
                "type": "string"
              }
            ]
          },
          "patternProperties": {
            "[tT][oO][kK][eE][nN]|[sS][eE][cC][rR][eE][tT]|[pP][aA][sS][sS][wW][oO][rR][dD]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]|[aA][pP][iI][^A-Za-z0-9]*[kK][eE][yY]|[aA][cC][cC][eE][sS][sS][^A-Za-z0-9]*[kK][eE][yY]|[pP][rR][iI][vV][aA][tT][eE][^A-Za-z0-9]*[kK][eE][yY]|^([aA][uU][tT][hH][oO][rR][iI][zZ][aA][tT][iI][oO][nN]|[cC][oO][oO][kK][iI][eE]|[pP][rR][oO][xX][yY][-_][aA][uU][tT][hH][oO][rR][iI][zZ][aA][tT][iI][oO][nN]|[sS][eE][tT][-_][cC][oO][oO][kK][iI][eE])$": {
              "additionalProperties": false,
              "properties": {
                "$ref": {
                  "additionalProperties": false,
                  "properties": {
                    "block_document_id": {
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "required": [
                    "block_document_id"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "$ref"
              ],
              "type": "object"
            }
          },
          "title": "Headers",
          "type": "object"
        },
        "query": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/McpSecretReference"
              },
              {
                "not": {
                  "pattern": "\\{\\{\\s*prefect\\.blocks\\.[^}]+\\}\\}"
                },
                "type": "string"
              }
            ]
          },
          "patternProperties": {
            "[tT][oO][kK][eE][nN]|[sS][eE][cC][rR][eE][tT]|[pP][aA][sS][sS][wW][oO][rR][dD]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]|[aA][pP][iI][^A-Za-z0-9]*[kK][eE][yY]|[aA][cC][cC][eE][sS][sS][^A-Za-z0-9]*[kK][eE][yY]|[pP][rR][iI][vV][aA][tT][eE][^A-Za-z0-9]*[kK][eE][yY]|^([aA][uU][tT][hH][oO][rR][iI][zZ][aA][tT][iI][oO][nN]|[cC][oO][oO][kK][iI][eE]|[pP][rR][oO][xX][yY][-_][aA][uU][tT][hH][oO][rR][iI][zZ][aA][tT][iI][oO][nN]|[sS][eE][tT][-_][cC][oO][oO][kK][iI][eE])$": {
              "additionalProperties": false,
              "properties": {
                "$ref": {
                  "additionalProperties": false,
                  "properties": {
                    "block_document_id": {
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "required": [
                    "block_document_id"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "$ref"
              ],
              "type": "object"
            }
          },
          "title": "Query",
          "type": "object"
        },
        "timeout": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        }
      },
      "required": [
        "type",
        "url"
      ],
      "title": "McpHttpServer",
      "type": "object"
    },
    "McpSecretReference": {
      "additionalProperties": false,
      "description": "A deferred MCP credential reference that saved-plan APIs never resolve.",
      "properties": {
        "$ref": {
          "$ref": "#/$defs/McpBlockDocumentReference"
        }
      },
      "required": [
        "$ref"
      ],
      "title": "McpSecretReference",
      "type": "object"
    },
    "McpStdioServer": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "stdio",
          "title": "Type",
          "type": "string"
        },
        "command": {
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "args": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/McpSecretReference"
              },
              {
                "not": {
                  "pattern": "\\{\\{\\s*prefect\\.blocks\\.[^}]+\\}\\}"
                },
                "type": "string"
              }
            ]
          },
          "title": "Args",
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/McpSecretReference"
              },
              {
                "not": {
                  "pattern": "\\{\\{\\s*prefect\\.blocks\\.[^}]+\\}\\}"
                },
                "type": "string"
              }
            ]
          },
          "patternProperties": {
            "[tT][oO][kK][eE][nN]|[sS][eE][cC][rR][eE][tT]|[pP][aA][sS][sS][wW][oO][rR][dD]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]|[aA][pP][iI][^A-Za-z0-9]*[kK][eE][yY]|[aA][cC][cC][eE][sS][sS][^A-Za-z0-9]*[kK][eE][yY]|[pP][rR][iI][vV][aA][tT][eE][^A-Za-z0-9]*[kK][eE][yY]|^([aA][uU][tT][hH][oO][rR][iI][zZ][aA][tT][iI][oO][nN]|[cC][oO][oO][kK][iI][eE]|[pP][rR][oO][xX][yY][-_][aA][uU][tT][hH][oO][rR][iI][zZ][aA][tT][iI][oO][nN]|[sS][eE][tT][-_][cC][oO][oO][kK][iI][eE])$": {
              "additionalProperties": false,
              "properties": {
                "$ref": {
                  "additionalProperties": false,
                  "properties": {
                    "block_document_id": {
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "required": [
                    "block_document_id"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "$ref"
              ],
              "type": "object"
            }
          },
          "title": "Env",
          "type": "object"
        }
      },
      "required": [
        "type",
        "command"
      ],
      "title": "McpStdioServer",
      "type": "object"
    },
    "NodeInputRef": {
      "additionalProperties": false,
      "description": "A reference from an edge to a named input on a node.",
      "properties": {
        "node": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
          "title": "Node",
          "type": "string"
        },
        "input": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
          "title": "Input",
          "type": "string"
        }
      },
      "required": [
        "node",
        "input"
      ],
      "title": "NodeInputRef",
      "type": "object"
    },
    "NodeLimits": {
      "additionalProperties": false,
      "properties": {
        "max_activations": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Activations"
        },
        "max_concurrent": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Concurrent"
        }
      },
      "title": "NodeLimits",
      "type": "object"
    },
    "NodeOrchestration": {
      "additionalProperties": false,
      "description": "Readiness, output, upstream terminal-state, retry, and limit policy for a node.",
      "properties": {
        "output_selection": {
          "enum": [
            "exactly_one",
            "one_or_more",
            "zero_or_one",
            "zero_or_more"
          ],
          "title": "Output Selection",
          "type": "string"
        },
        "evaluate_when": {
          "enum": [
            "all_reachable_terminal",
            "any_upstream_terminal",
            "all_required_inputs_produced",
            "manual"
          ],
          "title": "Evaluate When",
          "type": "string"
        },
        "on_upstream": {
          "anyOf": [
            {
              "$ref": "#/$defs/OnUpstream"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "on_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/OnFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limits": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeLimits"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "output_selection",
        "evaluate_when"
      ],
      "title": "NodeOrchestration",
      "type": "object"
    },
    "NodeOutputRef": {
      "additionalProperties": false,
      "description": "A reference from an edge to a named output on a node.",
      "properties": {
        "type": {
          "const": "node_output",
          "title": "Type",
          "type": "string"
        },
        "node": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
          "title": "Node",
          "type": "string"
        },
        "output": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
          "title": "Output",
          "type": "string"
        }
      },
      "required": [
        "type",
        "node",
        "output"
      ],
